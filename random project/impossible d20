            pulse = 10 + math.sin(t * 0.22) * 4
            c.create_oval(x - pulse, y - 98 - pulse, x + pulse, y - 98 + pulse, fill=self.accent_purple, outline="#ffffff", width=2)

    def draw_hp_bar(self, c, x, y, hp, max_hp, color, label=None):
        w = 76
        ratio = max(0.0, min(1.0, hp / max_hp))
        if label:
            c.create_text(x, y - 12, text=label, font=("Segoe UI", 8, "bold"), fill=self.fg_text)
        c.create_rectangle(x - w // 2, y - 4, x + w // 2, y + 4, fill="#090a0f", outline="#32384d")
        if ratio > 0:
            c.create_rectangle(
                x - w // 2 + 1, y - 3, x - w // 2 + int((w - 2) * ratio), y + 3, fill=color, outline=""
            )

    # ---------------- ОТРИСОВКА АНИМИРОВАННОГО КУБИКА D20 ----------------
    def draw_d20(self):
        c = self.dice_canvas
        c.delete("all")
        cx, cy = 75, 72
        r_outer = 58
        r_inner = 31
        ang = self.dice_angle if self.rolling else 0.0

        outer_pts = []
        for i in range(6):
            a = math.radians(i * 60 - 90) + ang
            outer_pts.append((cx + r_outer * math.cos(a), cy + r_outer * math.sin(a)))

        inner_pts = []
        for i in range(3):
            a = math.radians(i * 120 - 90) - ang * 0.6
            inner_pts.append((cx + r_inner * math.cos(a), cy + r_inner * math.sin(a)))

        flat_outer = [coord for pt in outer_pts for coord in pt]
        c.create_polygon(flat_outer, fill="#1e2230", outline=self.dice_color, width=3)

        for i in range(3):
            ix, iy = inner_pts[i]
            for idx in ((i * 2) % 6, (i * 2 + 1) % 6, (i * 2 - 1) % 6):
                ox, oy = outer_pts[idx]
                c.create_line(ix, iy, ox, oy, fill=self.dice_color, width=2)

        flat_inner = [coord for pt in inner_pts for coord in pt]
        c.create_polygon(flat_inner, fill="#282d40", outline=self.dice_color, width=2)

        c.create_text(
            cx,
            cy + 2,
            text=str(self.dice_val),
            font=("Georgia", 20, "bold"),
            fill=self.dice_color,
        )


