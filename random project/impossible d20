    def log(self, text, tag=None):
        self.log_box.configure(state="normal")
        self.log_box.insert("end", text + "\n", tag)
        self.log_box.see("end")
        self.log_box.configure(state="disabled")

    def update_hud(self):
        p = self.player
        self.lbl_hero.configure(
            text=f"{p['class']} (Ур. {p['level']})  |  HP: {p['hp']}/{p['max_hp']}  |  AC: {p['ac']}"
        )
        self.lbl_stats.configure(
            text=f"СИЛ +{p['str']}  ЛОВ +{p['dex']}  ИНТ +{p['int']}   |   Золото: {p['gold']}   |   Зелья: {p['potions']}"
        )

    # ---------------- ГЕНЕРАЦИЯ КОМНАТ ----------------
    def generate_room(self, first=False):
        self.room_cleared = False
        self.enemy = None
        self.hero_offset_x = -80.0 if not first else 0.0
        self.enemy_offset_x = 80.0
        self.room_transition_alpha = 1.0 if not first else 0.0

        if self.room % 5 == 0:
            self.room_type = "combat"
            self.enemy = BOSS.copy()
            self.lbl_room_title.configure(text=f"Комната {self.room}: Тронный зал Лича")
            self.lbl_room_desc.configure(
                text=f"Перед вами парит {self.enemy['name']} (HP {self.enemy['hp']}, AC {self.enemy['ac']})! Воздух пропитан некромантией."
            )
            self.log(f"=== КОМНАТА {self.room}: БОСС {self.enemy['name']} ===", "fail")
        else:
            self.room_type = random.choices(["combat", "chest", "trap", "altar"], weights=[55, 18, 15, 12])[0]
            if self.room_type == "combat":
                base = random.choice(MONSTERS).copy()
                scale = (self.room - 1) // 3
                base["hp"] += scale * 4
                base["max_hp"] = base["hp"]
                base["ac"] += min(3, scale // 2)
                base["dmg"] += scale
                self.enemy = base
                self.lbl_room_title.configure(text=f"Комната {self.room}: Засада в катакомбах")
                self.lbl_room_desc.configure(
                    text=f"Из тени выходит {self.enemy['name']} (HP {self.enemy['hp']}, AC {self.enemy['ac']}). Приготовьтесь к бою!"
                )
                self.log(f"--- Комната {self.room}: Враг {self.enemy['name']} ---", "enemy")
            elif self.room_type == "chest":
                self.lbl_room_title.configure(text=f"Комната {self.room}: Запертый реликварий")
                self.lbl_room_desc.configure(
                    text="В центре зала стоит окованный железом сундук с древним замком (Сложность DC 13)."
                )
                self.log(f"--- Комната {self.room}: Запертый сундук ---", "gold")
            elif self.room_type == "trap":
                self.lbl_room_title.configure(text=f"Комната {self.room}: Зал маятников и шипов")
                self.lbl_room_desc.configure(
                    text="Плиты под ногами зловеще проседают! Требуется спасбросок Ловкости (DC 13)."
                )
                self.log(f"--- Комната {self.room}: Ловушка! ---", "fail")
            else:
                self.lbl_room_title.configure(text=f"Комната {self.room}: Рунический алтарь")
                self.lbl_room_desc.configure(
                    text="Древний обелиск пульсирует синим светом. Проверка Интеллекта (DC 12) раскроет его дар."
                )
                self.log(f"--- Комната {self.room}: Магический алтарь ---", "info")

        if self.enemy and "max_hp" not in self.enemy:
            self.enemy["max_hp"] = self.enemy["hp"]

        self.update_hud()
        self.render_buttons()

    def render_buttons(self):
        for w in self.btn_frame.winfo_children():
            w.destroy()

        state = "disabled" if self.rolling else "normal"

        if self.player["hp"] <= 0:
            tk.Button(
                self.btn_frame,
                text="Начать новый поход",
                font=self.font_sub,
                bg=self.accent_red,
                fg="#12131a",
                relief="flat",
                padx=14,
                pady=8,
                command=self.show_class_selection,
            ).pack(side="left")
            return

        if self.room_cleared:
            tk.Button(
                self.btn_frame,
                text="Идти в следующую комнату ➔",
                font=self.font_sub,
                bg=self.accent_green,
                fg="#12131a",
                relief="flat",
                padx=16,
                pady=8,
                state=state,
                command=self.next_room,
            ).pack(side="left", padx=(0, 8))
        else:
            if self.room_type == "combat":
                tk.Button(
                    self.btn_frame,
                    text=f"⚔ Атаковать ({self.player['weapon']})",
                    font=self.font_sub,
                    bg=self.accent_red,
                    fg="#12131a",
                    relief="flat",
                    padx=14,
                    pady=8,
                    state=state,
                    command=self.action_attack,
                ).pack(side="left", padx=(0, 8))
            elif self.room_type == "chest":
                tk.Button(
                    self.btn_frame,
                    text="🗝 Взломать замок (ЛОВ, DC 13)",
                    font=self.font_sub,
                    bg=self.accent_gold,
                    fg="#12131a",
                    relief="flat",
                    padx=14,
                    pady=8,
                    state=state,
                    command=self.action_chest,
                ).pack(side="left", padx=(0, 8))
                tk.Button(
                    self.btn_frame,
                    text="Пройти мимо",
                    font=self.font_body,
                    bg=self.bg_card,
                    fg=self.fg_text,
                    relief="flat",
                    padx=12,
                    pady=8,
                    state=state,
                    command=self.skip_room,
                ).pack(side="left", padx=(0, 8))
            elif self.room_type == "trap":
                tk.Button(
                    self.btn_frame,
                    text="⚡ Спасбросок Ловкости (DC 13)",
                    font=self.font_sub,
                    bg=self.accent_blue,
                    fg="#12131a",
                    relief="flat",
                    padx=14,
                    pady=8,
                    state=state,
                    command=self.action_trap,
                ).pack(side="left", padx=(0, 8))
            elif self.room_type == "altar":
                tk.Button(
                    self.btn_frame,
                    text="✨ Изучить руны (ИНТ, DC 12)",
                    font=self.font_sub,
                    bg=self.accent_purple,
                    fg="#12131a",
                    relief="flat",
                    padx=14,
                    pady=8,
                    state=state,
                    command=self.action_altar,
                ).pack(side="left", padx=(0, 8))
                tk.Button(
                    self.btn_frame,
                    text="Не трогать",
                    font=self.font_body,
                    bg=self.bg_card,
                    fg=self.fg_text,
                    relief="flat",
                    padx=12,
                    pady=8,
                    state=state,
                    command=self.skip_room,
                ).pack(side="left", padx=(0, 8))

        if self.player["potions"] > 0 and self.player["hp"] < self.player["max_hp"]:
            tk.Button(
                self.btn_frame,
                text=f"🧪 Зелье ({self.player['potions']})",
                font=self.font_body,
                bg=self.bg_card,
                fg=self.accent_green,
                relief="flat",
                padx=12,
                pady=8,
                state=state,
                command=self.use_potion,
            ).pack(side="right")

    # ---------------- АНИМАЦИЯ КУБИКА D20 ----------------
    def roll_d20_animated(self, mod, target_dc, label, callback):
        self.rolling = True
        self.render_buttons()
        final_roll = random.randint(1, 20)
        total = final_roll + mod
        steps = 16

        def step(i):
            if i < steps:
                self.dice_val = random.randint(1, 20)
                self.dice_angle += 0.55 * (1.0 - i / (steps + 3))
                self.dice_color = self.accent_blue
                self.lbl_dice_formula.configure(text=f"{label}...", fg=self.fg_muted)
                delay = int(28 + (i ** 1.6) * 2.5)
                self.root.after(delay, lambda: step(i + 1))
            else:
                self.dice_val = final_roll
                if final_roll == 20:
                    self.dice_color = self.accent_green
                elif final_roll == 1:
                    self.dice_color = self.accent_red
                else:
                    self.dice_color = self.accent_gold

                sign = f"+{mod}" if mod >= 0 else str(mod)
                self.lbl_dice_formula.configure(
                    text=f"d20 ({final_roll}) {sign} = {total}  [Цель: {target_dc}]",
                    fg=self.dice_color,
                )
                self.rolling = False
                callback(final_roll, total)
                self.render_buttons()

        step(0)

    # ---------------- ДЕЙСТВИЯ И БОЕВЫЕ АНИМАЦИИ ----------------
    def spawn_vfx(self, x, y, kind, color):
        self.vfx_list.append({"x": x, "y": y, "kind": kind, "color": color, "life": 14, "max_life": 14})

    def spawn_floating_text(self, x, y, text, color):
        self.floating_texts.append({"x": x, "y": y, "text": text, "color": color, "life": 28})

    def action_attack(self):
        p = self.player
        mod = p[p["stat"]]
        ac = self.enemy["ac"]

        def on_roll(roll, total):
            # Рывок героя вперёд
            self.hero_offset_x = 55.0
            if roll == 1:
                self.log("КРИТИЧЕСКИЙ ПРОВАЛ (1)! Вы споткнулись и промахнулись.", "fail")
                self.spawn_floating_text(440, 120, "ПРОМАХ!", self.accent_red)
                self.root.after(450, self.enemy_turn)
                return

            if roll == 20 or total >= ac:
                dmg = random.randint(1, p["die"]) + mod
                if roll == 20:
                    dmg *= 2
                    self.log(f"НАТУРАЛЬНАЯ 20! Сокрушительный удар на {dmg} урона!", "crit")
                    self.spawn_vfx(445, 165, "crit", self.accent_gold)
                    self.spawn_floating_text(445, 105, f"КРИТ -{dmg}!", self.accent_gold)
                else:
                    self.log(f"Попадание ({total} vs AC {ac})! Нанесено {dmg} урона.", "crit")
                    vfx_kind = "magic" if p["class"] == "Маг" else "slash"
                    self.spawn_vfx(445, 165, vfx_kind, p["color"])
                    self.spawn_floating_text(445, 110, f"-{dmg}", self.accent_green)

                self.enemy["hp"] = max(0, self.enemy["hp"] - dmg)
                self.enemy_shake = 10

                if self.enemy["hp"] <= 0:
                    self.win_combat()
                else:
                    self.root.after(550, self.enemy_turn)
            else:
                self.log(f"Промах ({total} против AC {ac}). Броня врага выдержала удар.", "info")
                self.spawn_floating_text(445, 115, "БЛОК", self.fg_muted)
                self.root.after(450, self.enemy_turn)

        self.roll_d20_animated(mod, ac, "Атака", on_roll)

    def enemy_turn(self):
        if not self.enemy or self.enemy["hp"] <= 0:
            return
        self.enemy_offset_x = -55.0
        roll = random.randint(1, 20)
        total = roll + self.enemy["atk"]
        if roll == 20 or (roll != 1 and total >= self.player["ac"]):
            dmg = random.randint(2, self.enemy["dmg"])
            if roll == 20:
                dmg = int(dmg * 1.5)
            self.player["hp"] = max(0, self.player["hp"] - dmg)
            self.hero_shake = 10
            self.spawn_vfx(185, 165, "slash", self.accent_red)
            self.spawn_floating_text(185, 110, f"-{dmg}", self.accent_red)
            self.log(f"{self.enemy['name']} бьёт ({total} vs AC {self.player['ac']}) и наносит {dmg} урона!", "fail")
        else:
            self.spawn_floating_text(185, 115, "УКЛОНЕНИЕ", self.accent_blue)
            self.log(f"{self.enemy['name']} атакует ({total}), но вы уклонились!", "info")

        self.update_hud()
        if self.player["hp"] <= 0:
            self.lbl_room_title.configure(text="ПОРАЖЕНИЕ В ПОДЗЕМЕЛЬЕ")
            self.lbl_room_desc.configure(text=f"Вы пали на {self.room}-й комнате от руки {self.enemy['name']}.")
            self.log("Ваш герой пал...", "fail")
        self.render_buttons()

    def win_combat(self):
        xp = self.enemy["xp"]
        gold = self.enemy["gold"]
        self.player["xp"] += xp
        self.player["gold"] += gold
        self.log(f"Победа! Получено +{xp} XP и +{gold} золота.", "gold")
        self.spawn_floating_text(445, 95, f"+{gold} золота", self.accent_gold)
        self.check_level_up()
        self.room_cleared = True
        self.lbl_room_desc.configure(text=f"{self.enemy['name']} повержен! Путь дальше открыт.")
        self.update_hud()
        self.render_buttons()

    def action_chest(self):
        mod = self.player["dex"]
        def on_roll(roll, total):
            self.hero_offset_x = 40.0
            if roll == 20 or total >= 13:
                gold = random.randint(20, 40)
                self.player["gold"] += gold
                self.spawn_vfx(445, 180, "magic", self.accent_gold)
                self.spawn_floating_text(445, 120, f"+{gold} золота!", self.accent_gold)
                if random.random() < 0.45:
                    self.player["potions"] += 1
                    self.log(f"Замок вскрыт ({total})! Найдено {gold} золота и зелье лечения!", "crit")
                else:
                    self.log(f"Замок вскрыт ({total})! Внутри {gold} золотых монет.", "gold")
            elif roll == 1:
                dmg = random.randint(3, 6)
                self.player["hp"] = max(0, self.player["hp"] - dmg)
                self.hero_shake = 10
                self.spawn_vfx(185, 165, "slash", self.accent_red)
                self.spawn_floating_text(185, 110, f"-{dmg}", self.accent_red)
                self.log(f"Критическая неудача (1)! Сработала игла с ядом: -{dmg} HP.", "fail")
            else:
                self.log(f"Отмычка застряла ({total} против DC 13). Сундук не поддался.", "info")
            self.room_cleared = True
            self.update_hud()
            self.render_buttons()

        self.roll_d20_animated(mod, 13, "Взлом замка", on_roll)

    def action_trap(self):
        mod = self.player["dex"]
        def on_roll(roll, total):
            self.hero_offset_x = 45.0
            if roll == 20 or total >= 13:
                self.spawn_floating_text(220, 110, "ЛОВКИЙ РЫВОК!", self.accent_green)
                self.log(f"Успех ({total} vs DC 13)! Вы акробатически проскочили мимо лезвий.", "crit")
            else:
                dmg = random.randint(4, 9)
                self.player["hp"] = max(0, self.player["hp"] - dmg)
                self.hero_shake = 12
                self.spawn_vfx(220, 165, "slash", self.accent_red)
                self.spawn_floating_text(220, 110, f"-{dmg} HP", self.accent_red)
                self.log(f"Провал ({total} vs DC 13)! Лезвие задело вас на {dmg} урона.", "fail")
            self.room_cleared = True
            self.update_hud()
            self.render_buttons()

        self.roll_d20_animated(mod, 13, "Спасбросок Ловкости", on_roll)

    def action_altar(self):
        mod = self.player["int"]
        def on_roll(roll, total):
            if roll == 20 or total >= 12:
                heal = random.randint(8, 14)
                self.player["hp"] = min(self.player["max_hp"], self.player["hp"] + heal)
                self.player["xp"] += 25
                self.spawn_vfx(185, 160, "magic", self.accent_purple)
                self.spawn_floating_text(185, 105, f"+{heal} HP / +25 XP", self.accent_purple)
                self.log(f"Тайна рун раскрыта ({total})! Восстановлено {heal} HP и получено +25 XP.", "crit")
                self.check_level_up()
            else:
                self.log(f"Символы неясны ({total} vs DC 12). Алтарь погас.", "info")
            self.room_cleared = True
            self.update_hud()
            self.render_buttons()

        self.roll_d20_animated(mod, 12, "Тайные знания", on_roll)

    def use_potion(self):
        if self.player["potions"] <= 0:
            return
        self.player["potions"] -= 1
        heal = random.randint(1, 8) + 4
        self.player["hp"] = min(self.player["max_hp"], self.player["hp"] + heal)
        self.spawn_vfx(185, 165, "magic", self.accent_green)
        self.spawn_floating_text(185, 105, f"+{heal} HP", self.accent_green)
        self.log(f"Вы выпили зелье лечения и восстановили {heal} HP.", "crit")
        self.update_hud()
        self.render_buttons()

    def skip_room(self):
        self.room_cleared = True
        self.log("Вы решили не рисковать и двигаться дальше.", "info")
        self.render_buttons()

    def next_room(self):
        self.room += 1
        self.generate_room(first=False)

    def check_level_up(self):
        p = self.player
        if p["xp"] >= p["next_xp"]:
            p["xp"] -= p["next_xp"]
            p["level"] += 1
            p["next_xp"] = int(p["next_xp"] * 1.5)
            p["max_hp"] += 6
            p["hp"] = p["max_hp"]
            p[p["stat"]] += 1
            self.spawn_vfx(185, 155, "crit", self.accent_gold)
            self.spawn_floating_text(185, 85, "НОВЫЙ УРОВЕНЬ!", self.accent_gold)
            self.log(f"★ ПОВЫШЕНИЕ УРОВНЯ ({p['level']})! Макс. HP +6, основная характеристика +1!", "gold")

    # ---------------- ГЛАВНЫЙ ЦИКЛ АНИМАЦИИ ----------------
    def animation_loop(self):
        self.tick += 1
        # Плавное возвращение персонажей на исходные позиции
        self.hero_offset_x *= 0.78
        self.enemy_offset_x *= 0.78
        if abs(self.hero_offset_x) < 0.3:
            self.hero_offset_x = 0.0
        if abs(self.enemy_offset_x) < 0.3:
            self.enemy_offset_x = 0.0

        if self.enemy_shake > 0:
            self.enemy_shake -= 1
        if self.hero_shake > 0:
            self.hero_shake -= 1
        if self.room_transition_alpha > 0:
            self.room_transition_alpha = max(0.0, self.room_transition_alpha - 0.08)

        # Обновление визуальных эффектов и всплывающего текста
        for v in self.vfx_list:
            v["life"] -= 1
        self.vfx_list = [v for v in self.vfx_list if v["life"] > 0]

        for ft in self.floating_texts:
            ft["y"] -= 1.3
            ft["life"] -= 1
        self.floating_texts = [ft for ft in self.floating_texts if ft["life"] > 0]

        if self.player is not None and hasattr(self, "scene_canvas"):
            self.draw_scene()
            self.draw_d20()

        self.root.after(33, self.animation_loop)

    # ---------------- ОТРИСОВКА СЦЕНЫ ПОДЗЕМЕЛЬЯ ----------------
    def draw_scene(self):
        c = self.scene_canvas
        c.delete("all")
        w, h = 630, 270
        t = self.tick

        # Каменная стена и арки подземелья
        c.create_rectangle(0, 0, w, 215, fill="#151722", outline="")
        for row in range(0, 215, 36):
            offset = 30 if (row // 36) % 2 == 0 else 0
            c.create_line(0, row, w, row, fill="#1f2233", width=2)
            for col in range(-offset, w, 60):
                c.create_line(col, row, col, row + 36, fill="#1f2233", width=2)

        # Декоративные сводчатые арки на заднем плане
        for ax in (160, 315, 470):
            c.create_arc(ax - 55, 35, ax + 55, 210, start=0, extent=180, fill="#10121b", outline="#282c40", width=3)
            c.create_rectangle(ax - 55, 120, ax + 55, 215, fill="#10121b", outline="")

        # Каменный пол
        c.create_rectangle(0, 215, w, h, fill="#1f2330", outline="#32384d", width=2)
        for fx in range(0, w, 45):
            c.create_line(fx, 215, fx - 18, h, fill="#2b3042", width=2)

        # Мерцающие настенные факелы
        for idx, (tx, ty) in enumerate(self.torches):
            flicker = math.sin(t * 0.35 + idx * 2.1) * 4
            glow_r = 46 + flicker * 2
            c.create_oval(tx - glow_r, ty - glow_r, tx + glow_r, ty + glow_r, fill="#261c16", outline="")
            c.create_rectangle(tx - 4, ty, tx + 4, ty + 28, fill="#5c4033", outline="")
            # Языки пламени
            c.create_polygon(
                tx - 9, ty + 2,
                tx + flicker * 0.5, ty - 22 - flicker,
                tx + 9, ty + 2,
                fill="#e06c75", outline="", smooth=True
            )
            c.create_polygon(
                tx - 5, ty + 2,
                tx - flicker * 0.4, ty - 14 - flicker * 0.6,
                tx + 5, ty + 2,
                fill="#e5c07b", outline="", smooth=True
            )

        # Отрисовка Героя (слева)
        shake_hx = random.randint(-5, 5) if self.hero_shake > 0 else 0
        hx = 185 + self.hero_offset_x + shake_hx
        hy = 215
        self.draw_hero(c, hx, hy, t)

        # Отрисовка содержимого комнаты (справа)
        shake_ex = random.randint(-6, 6) if self.enemy_shake > 0 else 0
        ex = 445 + self.enemy_offset_x + shake_ex
        ey = 215

        if self.room_type == "combat" and self.enemy and self.enemy["hp"] > 0:
            self.draw_enemy(c, ex, ey, self.enemy, t)
        elif self.room_type == "chest":
            self.draw_chest(c, ex, ey, self.room_cleared)
        elif self.room_type == "trap":
            self.draw_trap(c, 355, ey, t)
        elif self.room_type == "altar":
            self.draw_altar(c, ex, ey, t, self.room_cleared)

        # Визуальные эффекты ударов / заклинаний
        for v in self.vfx_list:
            ratio = v["life"] / v["max_life"]
            r = (1.0 - ratio) * 48 + 10
            vx, vy = v["x"], v["y"]
            if v["kind"] == "slash":
                c.create_line(vx - r, vy - r, vx + r, vy + r, fill=v["color"], width=max(1, int(6 * ratio)))
                c.create_line(vx - r * 0.6, vy + r * 0.8, vx + r * 0.8, vy - r * 0.6, fill="#ffffff", width=max(1, int(3 * ratio)))
            elif v["kind"] == "magic":
                c.create_oval(vx - r, vy - r, vx + r, vy + r, outline=v["color"], width=max(1, int(4 * ratio)))
                c.create_oval(vx - r * 0.5, vy - r * 0.5, vx + r * 0.5, vy + r * 0.5, outline="#ffffff", width=2)
            else:
                for a in range(0, 360, 45):
                    rad = math.radians(a + t * 8)
                    c.create_line(
                        vx, vy,
                        vx + math.cos(rad) * r * 1.3,
                        vy + math.sin(rad) * r * 1.3,
                        fill=v["color"], width=3
                    )

        # Всплывающие цифры урона / лечения
        for ft in self.floating_texts:
            c.create_text(
                ft["x"], ft["y"], text=ft["text"], font=self.font_sub, fill=ft["color"]
            )

        # Эффект перехода в новую комнату (затемнение по краям)
        if self.room_transition_alpha > 0:
            bar_w = int(w * 0.5 * self.room_transition_alpha)
            c.create_rectangle(0, 0, bar_w, h, fill="#090a0f", outline="")
            c.create_rectangle(w - bar_w, 0, w, h, fill="#090a0f", outline="")

