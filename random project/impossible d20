        self.rolling = False

        # Состояние анимаций сцены и кубика
        self.tick = 0
        self.hero_offset_x = 0.0
        self.enemy_offset_x = 0.0
        self.enemy_shake = 0
        self.hero_shake = 0
        self.room_transition_alpha = 0.0
        self.vfx_list = []       # вспышки ударов, заклинаний, искры
        self.floating_texts = [] # всплывающий урон и хил
        self.torches = [(70, 95), (560, 95)]
        self.dice_angle = 0.0
        self.dice_val = 20
        self.dice_color = self.accent_gold

        self.show_class_selection()
        self.animation_loop()

    def clear_window(self):
        for widget in self.root.winfo_children():
            widget.destroy()

    # ---------------- ЭКРАН ВЫБОРА КЛАССА ----------------
    def show_class_selection(self):
        self.clear_window()
        frame = tk.Frame(self.root, bg=self.bg_main)
        frame.pack(expand=True, fill="both", padx=40, pady=35)

        tk.Label(
            frame,
            text="⚔ ПОДЗЕМЕЛЬЕ D20 ⚔",
            font=self.font_title,
            fg=self.accent_gold,
            bg=self.bg_main,
        ).pack(pady=(0, 8))

        tk.Label(
            frame,
            text="Выберите героя для спуска в анимированное подземелье:",
            font=self.font_body,
            fg=self.fg_muted,
            bg=self.bg_main,
        ).pack(pady=(0, 25))

        cards_frame = tk.Frame(frame, bg=self.bg_main)
        cards_frame.pack(expand=True, fill="both")

        for cls_name, data in CLASSES.items():
            card = tk.Frame(
                cards_frame,
                bg=self.bg_panel,
                highlightbackground=data["color"],
                highlightthickness=2,
                padx=18,
                pady=18,
            )
            card.pack(side="left", expand=True, fill="both", padx=10)

            tk.Label(
                card,
                text=cls_name.upper(),
                font=self.font_title,
                fg=data["color"],
                bg=self.bg_panel,
            ).pack(pady=(0, 10))

            stats_txt = (
                f"Здоровье (HP): {data['hp']}\n"
                f"Класс Брони (AC): {data['ac']}\n"
                f"Оружие: {data['weapon']}\n\n"
                f"СИЛ: +{data['str']}  |  ЛОВ: +{data['dex']}  |  ИНТ: +{data['int']}"
            )
            tk.Label(
                card,
                text=stats_txt,
                font=self.font_sub,
                fg=self.fg_text,
                bg=self.bg_panel,
                justify="center",
            ).pack(pady=8)

            tk.Label(
                card,
                text=data["desc"],
                font=self.font_body,
                fg=self.fg_muted,
                bg=self.bg_panel,
                wraplength=220,
                justify="center",
            ).pack(pady=10)

            tk.Button(
                card,
                text=f"Играть за {cls_name}",
                font=self.font_sub,
                bg=data["color"],
                fg="#12131a",
                activebackground=self.fg_text,
                relief="flat",
                padx=15,
                pady=8,
                cursor="hand2",
                command=lambda c=cls_name: self.start_game(c),
            ).pack(side="bottom", fill="x", pady=(10, 0))

    # ---------------- ИНИЦИАЛИЗАЦИЯ ИГРЫ ----------------
    def start_game(self, cls_name):
        base = CLASSES[cls_name]
        self.player = {
            "class": cls_name,
            "hp": base["hp"],
            "max_hp": base["hp"],
            "ac": base["ac"],
            "str": base["str"],
            "dex": base["dex"],
            "int": base["int"],
            "die": base["die"],
            "stat": base["stat"],
            "weapon": base["weapon"],
            "color": base["color"],
            "level": 1,
            "xp": 0,
            "next_xp": 60,
            "gold": 15,
            "potions": 2,
        }
        self.room = 1
        self.vfx_list.clear()
        self.floating_texts.clear()
        self.build_game_ui()
        self.generate_room(first=True)

