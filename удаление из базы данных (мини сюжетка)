def loading(text):
    print(text, end="", flush=True)
    for i in range(3):
        time.sleep(1)
        print(".", end="", flush=True)
    print()


def loading2(text):
    print(text, end="", flush=True)
    for i in range(4):
        time.sleep(1)
        print("\r" + text + "." * (i + 1), end="", flush=True)
    print("\r" + " " * (len(text) + 4), end="\r", flush=True) 
    print()

def Error(text):
    print(text, end="", flush=True)
